rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each operator can only read/write their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Pilot scope: one device document, readable by any signed-in
    // operator and writable by any signed-in operator (dashboard
    // "Node setup" page) or by the device's own service account.
    // If you add more operators/devices later, tighten this to check
    // a custom claim or an `ownerUid` field on the device doc instead.
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // The ESP32-S3 appends readings; nothing should ever edit or
      // delete a past reading, so only "create" is allowed.
      match /readings/{readingId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      match /alerts/{alertId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Allow acknowledging an alert, but not deleting the record.
        allow update: if request.auth != null;
        allow delete: if false;
      }
    }
  }
}
